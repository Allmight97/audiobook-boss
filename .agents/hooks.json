{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "repo_root=\"$(git rev-parse --show-toplevel 2>/dev/null)\" || exit 0; hook=\"$repo_root/.codex/hooks/pre_tool_use_guard.py\"; [ -f \"$hook\" ] || exit 0; python3 \"$hook\"",
						"timeout": 5,
						"statusMessage": "Checking ABB command safety"
					}
				]
			}
		]
	}
}
