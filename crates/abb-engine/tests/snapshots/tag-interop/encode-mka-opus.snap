# m4b mka-untouched
handling: encode
container: matroska,webm
format tags, in file order:
  title="Seed Title"
  SORT_ALBUM="Lower Series 01 - Seed Title"
  ARTIST="Seed Author"
  ALBUM_ARTIST="Seed Author"
  ALBUM="Seed Album"
  COMPOSER="Seed Narrator"
  GENRE="Seed Genre"
  DATE="2001-02"
  YEAR="2001"
  COMMENT="Seed Comment"
  DESCRIPTION="Seed Description"
  SERIES="Lower Series"
  SERIES-PART="1"
  DISC="1/3"
  MEDIA_TYPE="2"
  ENCODER=<varies>
streams:
  0 audio OPUS Disposition(0x0)
    DURATION=<varies>
  1 video MJPEG Disposition(ATTACHED_PIC)
    filename="cover.jpg"
    mimetype="image/jpeg"
    picture 630 bytes sha256 7cdbae51ccf7b3a8
as ABB reads it:
  title="Seed Title"
  artist="Seed Author"
  album="Seed Album"
  composer="Seed Narrator"
  genre="Seed Genre"
  date="2001-02"
  comment="Seed Comment"
  description="Seed Description"
  series="Lower Series"
  series_part="1"
  album_sort="Lower Series 01 - Seed Title"
  disk="(1, Some(3))"
  cover_art="630 bytes sha256 7cdbae51ccf7b3a8"

