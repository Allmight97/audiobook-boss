ID3 frames, in file order:
  TIT2
  TPE1
  TPE2
  TALB
  TCOM
  TCON
  TDRC
  TSOA
  TRCK
  TPOS
  COMM eng ""
  COMM eng "Notes"
  COMM fra ""
  COMM eng "iTunNORM"
  TXXX "description"
  TXXX "series"
  TXXX "SERIES"
  TXXX "series-part"
  TXXX "SERIES-PART"
  TXXX "----:com.apple.iTunes:SERIES"
  TXXX "----:com.apple.iTunes:SERIES-PART"
  TXXX "show"
  TXXX "episode_sort"
  TXXX "sort_album"
  TXXX "year"
  TXXX "ASIN"
  APIC image/png type 0
  APIC image/jpeg type 3
  APIC image/png type 4

