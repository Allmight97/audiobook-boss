# mka m4a-untouched
handling: preserve
container: mov,mp4,m4a,3gp,3g2,mj2
format tags, in file order:
  major_brand="isom"
  minor_version="512"
  compatible_brands="isomiso2mp41"
  title="Seed Title"
  artist="Seed Author"
  album_artist="Seed Author"
  composer="Seed Narrator"
  album="Seed Album"
  date="2001-02"
  encoder=<varies>
  comment="Seed Comment"
  genre="Seed Genre"
  description="Seed Description"
  media_type="2"
  disc="1/3"
  SERIES="Lower Series"
  SERIES-PART="1"
  sort_album="Lower Series 01 - Seed Title"
streams:
  0 audio OPUS Disposition(DEFAULT)
    language="und"
    handler_name="SoundHandler"
  1 video MJPEG Disposition(ATTACHED_PIC)
    picture 224 bytes sha256 1454a5c5c7ba3e73
