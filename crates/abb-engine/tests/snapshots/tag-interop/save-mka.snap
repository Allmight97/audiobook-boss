# save clear-all
container: matroska,webm
format tags, in file order:
  MEDIA_TYPE="2"
  ASIN="B000000001"
  ENCODER=<varies>
streams:
  0 audio OPUS Disposition(0x0)
    ENCODER=<varies>
    DURATION=<varies>
