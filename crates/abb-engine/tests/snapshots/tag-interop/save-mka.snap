  ----:COM.APPLE.ITUNES:SERIES-PART="7"
  SHOW="Show Series"
  EPISODE_SORT="5"
  SERIES-PART="2; 3"
  track="2/9"
  YEAR="2020"
  DISC="1/2"
  ENCODER=<varies>
streams:
  0 audio OPUS Disposition(0x0)
    ENCODER=<varies>
    DURATION=<varies>
