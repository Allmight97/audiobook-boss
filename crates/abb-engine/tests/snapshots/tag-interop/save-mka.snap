# save set-all
container: matroska,webm
format tags, in file order:
  title="Set Title"
  MEDIA_TYPE="2"
  SORT_ALBUM="Set Sort"
  ASIN="B000000001"
  ARTIST="Set Author"
  ALBUM_ARTIST="Set Author"
  ALBUM="Set Album"
  COMPOSER="Set Narrator"
  GENRE="Set Genre"
  DATE="2020-05"
  COMMENT="Set Comment"
  DESCRIPTION="Set Description"
  SERIES="Set Series; Set Subseries"
