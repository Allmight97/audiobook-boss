{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window - explicit least-privilege permissions",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-accept-first-mouse",
    "core:window:allow-set-ignore-drag-drop",
    "dialog:allow-open",
    "opener:allow-open-path"
  ]
}
