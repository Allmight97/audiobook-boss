{
	"name": "audiobook-boss",
	"private": true,
	"description": "AudioBook Boss™ — Batch audiobook processing and metadata management",
	"version": "1.15.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"fmt": "bunx @biomejs/biome format --write --no-errors-on-unmatched .",
		"fmt:check": "bunx @biomejs/biome format --no-errors-on-unmatched .",
		"fmt:changed": "bunx @biomejs/biome format --write --changed --no-errors-on-unmatched",
		"lint:check": "bunx @biomejs/biome lint --error-on-warnings --no-errors-on-unmatched .",
		"audit:rust": "cargo audit -D warnings",
		"audit:js": "bun audit",
		"audit": "bun run --sequential --no-exit-on-error audit:rust audit:js",
		"preview": "vite preview",
		"tauri": "bun scripts/tauri.ts",
		"app:dev:log": "bash scripts/dev-tauri-log.sh",
		"aaxclean-helper:publish": "bun scripts/publish-aaxclean-helper.ts",
		"app:build": "bun scripts/build-app.ts --bundles app",
		"app:build:dmg": "bun scripts/build-app.ts --bundles app,dmg",
		"app:build:all": "bun scripts/build-app.ts --bundles all",
		"app:install-local": "bun scripts/install-local-app.ts",
		"app:install-local:existing": "bun scripts/install-local-app.ts --skip-build",
		"clean": "rm -rf target/release dist node_modules/.vite tools/abb-aaxclean-helper/.publish",
		"bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --features bundled-ffmpeg,binding-export --bin export_bindings --",
		"bindings:check": "scripts/check-generated-bindings.sh",
		"bindings:check:runtime-boundary": "bun scripts/check-tauri-runtime-boundary.ts",
		"check:rust-complexity": "bash scripts/check-rust-complexity.sh",
		"check:rust-tiers": "bash scripts/check-rust-tiers.sh",
		"test": "vitest run",
		"test:watch": "vitest",
		"update:rc": "bun add --exact solid-js@next @solidjs/web@next && bun add --dev --exact @solidjs/vite-plugin@latest @solidjs/testing-library@next"
	},
	"dependencies": {
		"@solidjs/web": "2.0.0-rc.13",
		"@tauri-apps/api": "^2.12.2",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"solid-js": "2.0.0-rc.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@solidjs/testing-library": "1.0.0-beta.3",
		"@solidjs/vite-plugin": "3.0.0-next.47",
		"@tauri-apps/cli": "^2.12.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/user-event": "^14.6.7",
		"bun": "^1.4.3",
		"jsdom": "^30.1.1",
		"knip": "^6.41.0",
		"linguist-languages": "9.5.0",
		"picomatch": "^4.0.7",
		"typescript": "npm:typescript@7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"@tauri-apps/api": "2.12.1",
		"source-map-js": "1.2.2",
		"nanoid": "3.3.18",
		"undici": "^7.29.0"
	}
}
