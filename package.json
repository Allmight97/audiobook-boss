{
	"name": "audiobook-boss",
	"private": true,
	"description": "AudioBook Boss™ — Batch audiobook processing and metadata management",
	"version": "1.8.2",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"typecheck": "tsc --noEmit",
		"fmt": "bunx @biomejs/biome format --write --no-errors-on-unmatched .",
		"fmt:check": "bunx @biomejs/biome format --no-errors-on-unmatched .",
		"fmt:changed": "bunx @biomejs/biome format --write --changed --no-errors-on-unmatched",
		"lint:check": "bunx @biomejs/biome lint --no-errors-on-unmatched .",
		"audit:rust": "cargo audit -D warnings",
		"audit:js": "bun audit",
		"audit": "bun run --sequential --no-exit-on-error audit:rust audit:js",
		"preview": "vite preview",
		"tauri": "bun scripts/tauri.ts",
		"app:dev:log": "bash scripts/dev-tauri-log.sh",
		"aaxclean-helper:publish": "bun scripts/publish-aaxclean-helper.ts",
		"app:build": "bun scripts/build-app.ts --bundles app",
		"app:build:dmg": "bun scripts/build-app.ts --bundles app,dmg",
		"app:build:all": "bun scripts/build-app.ts --bundles all",
		"app:install-local": "bun scripts/install-local-app.ts",
		"app:install-local:existing": "bun scripts/install-local-app.ts --skip-build",
		"bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --features bundled-ffmpeg,binding-export --bin export_bindings",
		"aac-decoder-contract:check": "cargo run --manifest-path src-tauri/Cargo.toml --features bundled-ffmpeg,decoder-contract --bin verify_aac_decoder_contract",
		"bindings:check": "scripts/check-generated-bindings.sh --mode verify",
		"bindings:check:local": "scripts/check-generated-bindings.sh --mode local",
		"bindings:check:runtime-boundary": "bun scripts/check-tauri-runtime-boundary.ts",
		"bindings:sync": "scripts/check-generated-bindings.sh --mode sync",
		"test": "vitest run",
		"test:watch": "vitest",
		"update:rc": "bun add --exact effect@rc solid-js@next @solidjs/web@next && bun add --dev --exact @solidjs/vite-plugin@latest @solidjs/testing-library@next"
	},
	"dependencies": {
		"@solidjs/web": "2.0.0-rc.6",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"effect": "4.0.0-rc.112",
		"solid-js": "2.0.0-rc.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@solidjs/testing-library": "1.0.0-beta.3",
		"@solidjs/vite-plugin": "3.0.0-next.39",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/user-event": "^14.6.6",
		"@typescript/native": "npm:typescript@7.0.2",
		"jsdom": "^30.0.1",
		"typescript": "npm:typescript@7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"@tauri-apps/api": "2.11.1",
		"nanoid": "3.3.18",
		"undici": "^7.29.0"
	}
}
