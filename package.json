{
	"name": "audiobook-boss",
	"private": true,
	"description": "AudioBook Boss™ — Batch audiobook processing and metadata management",
	"version": "1.19.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
		"knip": "knip",
		"ci:timing": "bun scripts/ci-timing.ts",
		"ffmpeg:pin": "bun scripts/ffmpeg-upstream.ts --pin",
		"ffmpeg:upstream": "bun scripts/ffmpeg-upstream.ts",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint:check": "oxlint --type-aware --deny-warnings --report-unused-disable-directives && biome lint --error-on-warnings --no-errors-on-unmatched . && bun scripts/check-known-mistakes.ts",
		"audit:rust": "cargo audit -D warnings",
		"audit:js": "bun audit",
		"audit": "bun run --sequential --no-exit-on-error audit:rust audit:js",
		"preview": "vite preview",
		"tauri": "bun scripts/tauri.ts",
		"app:dev:log": "bash scripts/dev-tauri-log.sh",
		"app:build": "bun scripts/build-app.ts --bundles app",
		"app:build:dmg": "bun scripts/build-app.ts --bundles app,dmg",
		"app:build:all": "bun scripts/build-app.ts --bundles all",
		"app:install-local": "bun scripts/install-local-app.ts",
		"app:install-local:existing": "bun scripts/install-local-app.ts --skip-build",
		"clean": "bun scripts/clean.ts",
		"bindings:generate": "cargo run --manifest-path src-tauri/Cargo.toml --features bundled-ffmpeg,binding-export --bin export_bindings --",
		"bindings:check": "scripts/check-generated-bindings.sh",
		"bindings:check:runtime-boundary": "bun scripts/check-tauri-runtime-boundary.ts",
		"check:rust-complexity": "bash scripts/check-rust-complexity.sh",
		"check:rust-tiers": "bash scripts/check-rust-tiers.sh",
		"test": "vitest run",
		"test:watch": "vitest",
		"update:rc": "bun add --exact solid-js@next @solidjs/web@next && bun add --dev --exact @solidjs/vite-plugin@latest @solidjs/testing-library@next"
	},
	"dependencies": {
		"@solidjs/web": "2.0.0-rc.20",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"solid-js": "2.0.0-rc.18"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@solidjs/testing-library": "1.0.0-rc.2",
		"@solidjs/vite-plugin": "3.0.0-next.53",
		"@tauri-apps/cli": "^2.12.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/user-event": "^14.6.8",
		"@types/bun": "^1.4.4",
		"@types/picomatch": "^4.0.3",
		"bun": "^1.4.4",
		"jsdom": "^30.1.3",
		"knip": "^6.44.0",
		"linguist-languages": "9.5.0",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"picomatch": "^4.0.7",
		"typescript": "npm:typescript@^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"@tauri-apps/api": "2.12.4",
		"source-map-js": "^1.2.2",
		"nanoid": "^3.3.20",
		"undici": "^7.30.1"
	}
}
