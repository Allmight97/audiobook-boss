# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.mise.local.toml

# Local Codex/agent state
.agents/settings.local.json
.agents/environments/environment.toml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# macOS metadata noise
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
docs/model_tests/*

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyc.*
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Rust build artifacts (root workspace + src-tauri)
/target/
/src-tauri/target/


# Local coverage reports
/coverage/

# Generated presentation companions belong outside repo docs.
/docs/**/*.html

# Local AI/editor settings
.claude/
.cursor/
opencode.json
.btca/
.learnings/

# Perf run artifacts (generated locally/CI)
/scripts/perf/results/*
!/scripts/perf/results/.gitkeep

# Repomix handoff artifacts (local AI context exports)
/.repomix/handoffs/*
!/.repomix/handoffs/.gitkeep

# Local generated reports / AI artifacts
/.artifacts/*
!/.artifacts/harness/
!/.artifacts/harness/.gitkeep

# Generated human-facing artifacts belong under .artifacts, not docs canon
/docs/artifacts/
