#!/usr/bin/env bash
# Fast checks on staged files.
# Formatters and lints only; no builds, no tests. setup.sh installs it
# with `git config core.hooksPath .githooks`.
# Skip once with `git commit --no-verify`; CI still runs the full lanes.
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

snapshot="$(mktemp -d "${TMPDIR:-/tmp}/abb-staged.XXXXXX")"
trap 'rm -rf "${snapshot}"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z >"${snapshot}/paths"
staged=()
while IFS= read -r -d '' file; do
	staged+=("${file}")
done <"${snapshot}/paths"
[[ ${#staged[@]} -gt 0 ]] || exit 0
git diff --cached --check

# Check the index's bytes so partial staging cannot validate a different commit.
git_dir="$(git rev-parse --absolute-git-dir)"
index_file="$(git rev-parse --git-path index)"
[[ "${index_file}" == /* ]] || index_file="${repo_root}/${index_file}"
mkdir "${snapshot}/tree"
git checkout-index --all --prefix="${snapshot}/tree/"
if [[ -d "${repo_root}/node_modules" ]]; then
	ln -s "${repo_root}/node_modules" "${snapshot}/tree/node_modules"
fi
printf 'gitdir: %s\n' "${git_dir}" >"${snapshot}/tree/.git"
export GIT_DIR="${git_dir}" GIT_INDEX_FILE="${index_file}" GIT_WORK_TREE="${snapshot}/tree"
cd "${snapshot}/tree"
eval "$(scripts/setup.sh --print-env)"

has() {
	local pattern="$1" file
	for file in "${staged[@]}"; do
		[[ "${file}" =~ ${pattern} ]] && return 0
	done
	return 1
}

require() {
	command -v "$1" >/dev/null 2>&1 && return 0
	printf 'pre-commit: %s is missing; run: bash scripts/setup.sh\n' "$1" >&2
	exit 1
}

if has '\.rs$'; then
	require cargo
	cargo fmt --all -- --check
fi
if has '\.(ts|tsx|js|json|jsonc|css)$'; then
	require bun
	bunx @biomejs/biome format --no-errors-on-unmatched "${staged[@]}"
fi
if has '(^|/)(AGENTS|CLAUDE|REVIEW|README)\.md$|^\.agents/|^docs/'; then
	require bun
	bun scripts/check-guidance.ts
fi
if has '^\.github/workflows/'; then
	require bun
	bun scripts/check-pr-workflow-policy.ts
fi
if has '\.(sh|rs)$|^\.githooks/'; then
	require bun
	bun scripts/check-known-mistakes.ts
fi
shell_files=()
for file in "${staged[@]}"; do
	if [[ "${file}" == *.sh || "${file}" == .githooks/* ]]; then
		shell_files+=("${file}")
	fi
done
if [[ ${#shell_files[@]} -gt 0 ]]; then
	require shellcheck
	shellcheck -S warning "${shell_files[@]}"
fi
# Staged source against HEAD. CI passes --against the pull-request base,
# because a PR checkout makes the index and HEAD the same commit.
require bun
bun scripts/check-file-size.mjs "${staged[@]}"
